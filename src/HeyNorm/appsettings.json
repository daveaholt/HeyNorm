{
  "Wake": {
    // Matched against the Whisper transcript with punctuation and casing stripped, so
    // "Hey, Norm." matches "hey norm". Add variants if Whisper keeps mishearing you.
    "WakePhrases": [ "hey norm", "hey norman" ],
    // Ends the session. Matched at the end of an utterance, so "okay Norm, done" works too.
    "StopPhrases": [ "norm done", "norm im done", "thanks norm", "goodbye norm", "bye norm" ]
  },

  "Speech": {
    // Download from https://huggingface.co/ggerganov/whisper.cpp (base.en is a good start; small.en if you have the GPU).
    "WhisperModelPath": "models/ggml-base.en.bin",
    // Optional. If blank, falls back to the built-in Windows voice.
    "PiperExePath": "piper/piper.exe",
    "PiperVoicePath": "piper/en_US-ryan-medium.onnx",
    // 0 = least aggressive, 3 = most aggressive at filtering out noise. Shop noise wants 3.
    "VadAggressiveness": 3,
    // How long a pause means "I'm done talking".
    "EndOfUtteranceSilenceMs": 900,
    // End the session after this long with no speech at all.
    "SessionIdleTimeoutSeconds": 60,
    // Longest single utterance before it's cut off and sent anyway.
    "MaxUtteranceSeconds": 30,
    // Whisper scores each stretch of audio 0-1 for "no speech here"; above this it is dropped
    // as noise. Raise it if quiet requests get ignored, lower it if Norm answers phrases
    // nobody said. The log shows every drop with its score.
    "NoSpeechThreshold": 0.7
  },

  "Assistant": {
    // Don't name a tool in here. Models echo the name into their reply, and Norm then reads
    // "end session" out loud instead of calling it — measurably worse than describing it.
    "SystemPrompt": "You are Norm, a voice assistant in a woodworking shop. Your replies are spoken aloud, so keep them short and conversational, use no markdown, lists, or emoji, and say numbers the way a person would. Never write a tool's name in your reply: either call the tool or speak plainly. Use tools when they help. If you aren't sure of a fact, or it could have changed since you learned it, look it up instead of guessing. If a tool can answer, call it straight away; never say you will check something without calling the tool in the same reply. When the person's request is fully handled and they seem done, end the session with the tool provided.",
    // Which entry under Tasks drives the spoken conversation.
    "ConversationTask": "conversation",
    "MaxToolRoundsPerTurn": 5
  },

  "Search": {
    // A SearXNG instance running locally in Docker (README step 5). Leave blank to switch
    // web search off; Norm then never offers it.
    "SearXngUrl": "http://localhost:8888",
    // Results handed to the model per search. More means better answers and a slower reply.
    "MaxResults": 4
  },

  "Weather": {
    // Open-Meteo: free for non-commercial use, no key. HomeLocation is the town Norm uses
    // when you don't name one, e.g. "Austin, Texas". Blank means Norm asks which town.
    "HomeLocation": "St. Louis, MO",
    // "imperial" (Fahrenheit, mph, inches) or "metric".
    "Units": "imperial"
  },

  "Providers": {
    "ollama": {
      "Type": "Ollama",
      "BaseUrl": "http://localhost:11434"
    },
    "claude": {
      "Type": "Claude",
      "BaseUrl": "https://api.anthropic.com",
      // Never put the key itself here.
      "ApiKeyEnvVar": "ANTHROPIC_API_KEY"
    }
  },

  // Each feature asks for a task by name; this maps it to a provider + model.
  // Switching to Claude later is just: "Provider": "claude", "Model": "claude-sonnet-5-5".
  "Tasks": {
    "default": { "Provider": "ollama", "Model": "qwen3:8b", "MaxTokens": 1024, "Think": false },
    "conversation": { "Provider": "ollama", "Model": "qwen3:8b", "MaxTokens": 512, "Think": false }
  }
}
